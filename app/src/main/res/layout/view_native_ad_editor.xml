<?xml version="1.0" encoding="utf-8"?>
<!-- Нативная реклама под панелью инструментов фото- и видеоредактора (тёмная тема).
     Компактная: вся высота укладывается в 70dp. -->
<com.yandex.mobile.ads.nativeads.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_ad_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">

            <!-- Иконка приложения либо медиа (что есть в объявлении) -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <com.yandex.mobile.ads.nativeads.MediaView
                    android:id="@+id/native_ad_media"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_native_ad_icon" />

                <ImageView
                    android:id="@+id/native_ad_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_native_ad_icon"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/native_ad_sponsored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_native_ad_badge"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="1dp"
                        android:textColor="#FF8E8E93"
                        android:textSize="8dp" />

                    <TextView
                        android:id="@+id/native_ad_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FF8E8E93"
                        android:textSize="8dp" />

                    <ImageView
                        android:id="@+id/native_ad_favicon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/native_ad_domain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FF8E8E93"
                        android:textSize="8dp" />

                    <TextView
                        android:id="@+id/native_ad_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="9dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/native_ad_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FF8E8E93"
                    android:textSize="10dp" />

                <!-- Если есть предупреждение, оно показывается вместо основного текста -->
                <TextView
                    android:id="@+id/native_ad_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FF8E8E93"
                    android:textSize="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/native_ad_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_native_ad_cta"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxWidth="110dp"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11dp"
                android:textStyle="bold" />

            <!-- Место под кнопку закрытия: сам крестик рисуется в Compose поверх макета -->
            <Space
                android:layout_width="30dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- Значок меню объявления — в левом верхнем углу, поверх иконки -->
        <ImageView
            android:id="@+id/native_ad_feedback"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_native_ad_feedback"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="centerInside" />
    </FrameLayout>
</com.yandex.mobile.ads.nativeads.NativeAdView>